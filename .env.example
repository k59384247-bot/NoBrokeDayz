# Browser-safe values only. Copy the local URLs/keys from `npm run supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=replace-with-local-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_URL=replace-with-local-project-url
SUPABASE_SECRET_KEY=replace-with-local-secret-key
SUPABASE_DB_URL=replace-with-local-database-url
